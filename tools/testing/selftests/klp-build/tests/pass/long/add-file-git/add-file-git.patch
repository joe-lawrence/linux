From: Test Author <test@example.com>
Subject: [PATCH] proc/meminfo: add test headers

Add new files livepatch test case (git format-patch style).

This patch adds two new header files using git format-patch format
to verify klp-build handles patches that add new files.

diff --git a/fs/proc/klp_test_header1.h b/fs/proc/klp_test_header1.h
new file mode 100644
--- /dev/null
+++ b/fs/proc/klp_test_header1.h
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KLP_TEST_HEADER1_H
+#define _KLP_TEST_HEADER1_H
+
+#define KLP_TEST_MARKER1 "klp-build-test: header1 included"
+#endif
diff --git a/fs/proc/klp_test_header2.h b/fs/proc/klp_test_header2.h
new file mode 100644
--- /dev/null
+++ b/fs/proc/klp_test_header2.h
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KLP_TEST_HEADER2_H
+#define _KLP_TEST_HEADER2_H
+
+#define KLP_TEST_MARKER2 "klp-build-test: header2 included"
+#endif
diff --git a/fs/proc/meminfo.c b/fs/proc/meminfo.c
--- a/fs/proc/meminfo.c
+++ b/fs/proc/meminfo.c
@@ -19,6 +19,8 @@
 #include <linux/cma.h>
 #endif
 #include <linux/zswap.h>
+#include "klp_test_header1.h"
+#include "klp_test_header2.h"
 #include <asm/page.h>
 #include "internal.h"
 
@@ -36,6 +38,8 @@ static int meminfo_proc_show(struct seq_file *m, void *v)
 	struct sysinfo i;
 	unsigned long committed;
 	long cached;
+	pr_info(KLP_TEST_MARKER1 "\n");
+	pr_info(KLP_TEST_MARKER2 "\n");
 	long available;
 	unsigned long pages[NR_LRU_LISTS];
 	unsigned long sreclaimable, sunreclaim;
