From: Test Author <test@example.com>
Subject: [PATCH] proc/meminfo: add test headers

Add new files livepatch test case (diff -Nupr format).

This patch adds two new header files using diff -Nupr format to verify
klp-build handles patches that add new files with both epoch timestamp
formats (1970 and 1969) that diff generates depending on timezone.

diff -Nupr a/fs/proc/klp_test_header1.h b/fs/proc/klp_test_header1.h
--- a/fs/proc/klp_test_header1.h	1970-01-01 00:00:00.000000000 +0000
+++ b/fs/proc/klp_test_header1.h	2026-02-06 12:00:00.000000000 +0000
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KLP_TEST_HEADER1_H
+#define _KLP_TEST_HEADER1_H
+
+#define KLP_TEST_MARKER1 "klp-build-test: header1 included"
+#endif
diff -Nupr a/fs/proc/klp_test_header2.h b/fs/proc/klp_test_header2.h
--- a/fs/proc/klp_test_header2.h	1969-12-31 19:00:00.000000000 -0500
+++ b/fs/proc/klp_test_header2.h	2026-02-06 12:00:00.000000000 +0000
@@ -0,0 +1,6 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KLP_TEST_HEADER2_H
+#define _KLP_TEST_HEADER2_H
+
+#define KLP_TEST_MARKER2 "klp-build-test: header2 included"
+#endif
diff -Nupr a/fs/proc/meminfo.c b/fs/proc/meminfo.c
--- a/fs/proc/meminfo.c	2026-02-06 12:00:00.000000000 +0000
+++ b/fs/proc/meminfo.c	2026-02-06 12:00:01.000000000 +0000
@@ -19,6 +19,8 @@
 #include <linux/cma.h>
 #endif
 #include <linux/zswap.h>
+#include "klp_test_header1.h"
+#include "klp_test_header2.h"
 #include <asm/page.h>
 #include "internal.h"
 
@@ -36,6 +38,8 @@ static int meminfo_proc_show(struct seq
 	struct sysinfo i;
 	unsigned long committed;
 	long cached;
+	pr_info(KLP_TEST_MARKER1 "\n");
+	pr_info(KLP_TEST_MARKER2 "\n");
 	long available;
 	unsigned long pages[NR_LRU_LISTS];
 	unsigned long sreclaimable, sunreclaim;
